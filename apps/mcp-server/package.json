{
  "name": "unizero-mcp",
  "version": "0.1.0",
  "description": "UniZero MCP server: papers, Raw Markdown, tables, and references for agents, backed by the add-on bridge",
  "private": true,
  "type": "module",
  "bin": {
    "unizero-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
