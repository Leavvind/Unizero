{
  "npm": {
    "publish": false
  },
  "git": {
    "requireBranch": "main",
    "tagName": "v${version}"
  },
  "github": {
    "release": false
  },
  "hooks": {
    "after:bump": "node scripts/sync-obsidian-version.mjs && npm run build",
    "after:release": "echo Pushed ${name} v${version}; GitHub Actions will publish the XPI."
  }
}
