{
  "name": "unizero-obsidian",
  "version": "0.1.0",
  "description": "UniZero for Obsidian: Zotero papers in notes, backed by the add-on bridge",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node esbuild.config.mjs production && npm run tsc",
    "dev": "node esbuild.config.mjs",
    "check": "tsc --noEmit",
    "tsc": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "author": "Leavvind",
  "license": "AGPL-3.0-or-later",
  "devDependencies": {
    "@codemirror/language": "^6.10.2",
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@types/node": "^18.13.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.17.7",
    "obsidian": "1.13.1",
    "typescript": "^4.9.5",
    "vitest": "^1.6.1"
  }
}
